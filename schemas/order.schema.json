{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intelligent-delivery.example/schemas/order.schema.json",
  "title": "Delivery order",
  "type": "object",
  "additionalProperties": false,
  "required": ["order_id", "idempotency_key", "product", "notes", "address", "payment_method"],
  "properties": {
    "order_id": {"type": "string", "pattern": "^ORD-[A-Z0-9-]{3,48}$"},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$"},
    "correlation_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$"},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sku", "name", "quantity"],
      "properties": {
        "sku": {"type": "string", "pattern": "^[A-Z0-9-]{2,32}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "quantity": {"type": "integer", "minimum": 1, "maximum": 50}
      }
    },
    "notes": {"type": "string", "maxLength": 2000},
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city", "state", "postal_code", "delivery_instructions"],
      "properties": {
        "city": {"type": "string", "minLength": 2, "maxLength": 100},
        "state": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "postal_code": {"type": "string", "pattern": "^[0-9]{5}-?[0-9]{3}$"},
        "delivery_instructions": {"type": "string", "maxLength": 500}
      }
    },
    "payment_method": {"type": "string", "enum": ["CARD", "PIX", "CASH"]}
  }
}

